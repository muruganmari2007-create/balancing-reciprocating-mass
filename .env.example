# Copy to .env and fill in ANY ONE of these. With none set, Animex runs in
# offline demo mode (built-in solvers for equations, sorting, plots, etc).

PORT=3000

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Groq (free tier: https://console.groq.com/keys) -----------------------
# Any OpenAI-compatible endpoint works here: Groq, OpenRouter, a local
# Ollama (OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1, key = "ollama").
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

# --- Anthropic Claude (paid, best quality: https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Cheaper option: ANTHROPIC_MODEL=claude-haiku-5-5
